#!/bin/sh
# 每天备份 SQLite（在线热备份，不停服务），保留 14 天。由 setup-server.sh 安装到 /etc/cron.daily/
set -e
DIR=/srv/investwise/backup
DB=/srv/investwise/data/investwise.db
[ -f "$DB" ] || exit 0
mkdir -p "$DIR"
sqlite3 "$DB" ".backup '$DIR/investwise-$(date +%F).db'"
gzip -f "$DIR/investwise-$(date +%F).db"
find "$DIR" -name 'investwise-*.db.gz' -mtime +14 -delete
chown -R investwise:investwise "$DIR"
