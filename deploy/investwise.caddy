# InvestWise 站点：由 setup-server.sh 复制到 /etc/caddy/investwise.caddy，并在主 Caddyfile 里 import
# Caddy 会自动申请和续期 HTTPS 证书（前提：DNS 已解析到本机，80/443 端口已放行）
investwise.waywise.tech {
	encode zstd gzip

	# 持仓文件上传最大 5MB，与 app/main.py 一致（留点余量）
	request_body {
		max_size 6MB
	}

	reverse_proxy 127.0.0.1:8100

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
