# 复制为 .env 后填写

# 必填：DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 推荐：博查 AI 搜索（A股/港股/美股的中文新闻与公告补充） https://open.bochaai.com
BOCHA_API_KEY=

# 推荐：Finnhub（美股公司新闻，免费额度够用） https://finnhub.io
FINNHUB_API_KEY=

# SEC EDGAR 要求带联系方式的 User-Agent（美股公告，免费，无需 key）
SEC_USER_AGENT=InvestWise your-email@example.com

# 注册邀请码（小圈子使用，防止陌生人注册）
INVITE_CODE=change-me

# 每日检索时间（北京时间）
DAILY_RUN_TIME=07:30

# 后台管理员用户名（逗号分隔），注册或服务启动时自动设为管理员；其他管理员可在后台 /admin 设置
ADMIN_USERNAMES=佳侣

# DeepSeek 单价（元/百万 tokens），只用于后台成本估算，以控制台账单为准
DEEPSEEK_PRICE_INPUT=2
DEEPSEEK_PRICE_CACHED=0.2
DEEPSEEK_PRICE_OUTPUT=3
