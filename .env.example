# 复制为 .env 后填写

# 必填：DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 推荐：博查 AI 搜索（A股/港股/美股的中文新闻与公告补充） https://open.bochaai.com
BOCHA_API_KEY=

# 推荐：Finnhub（美股公司新闻，免费额度够用） https://finnhub.io
FINNHUB_API_KEY=

# SEC EDGAR 要求带联系方式的 User-Agent（美股公告，免费，无需 key）
SEC_USER_AGENT=InvestWise your-email@example.com

# 注册邀请码（小圈子使用，防止陌生人注册）
INVITE_CODE=change-me

# 每日检索时间（北京时间）
DAILY_RUN_TIME=07:30

# 后台管理员用户名（逗号分隔），注册或服务启动时自动设为管理员；其他管理员可在后台 /admin 设置
ADMIN_USERNAMES=

# DeepSeek 单价（元/百万 tokens），只用于后台成本估算，以控制台账单为准
DEEPSEEK_PRICE_INPUT=2
DEEPSEEK_PRICE_CACHED=0.2
DEEPSEEK_PRICE_OUTPUT=3
BOCHA_PRICE_PER_CALL=0.036

# ---------- 成本控制 ----------
# 博查用法：fallback = 港股总是搜，A股/美股只在免费源（AKShare / Finnhub + SEC）没抓到信息时补搜；always = 每家都搜
BOCHA_MODE=fallback
# 超过这么多天没访问网站的用户暂停每日检索，再次访问时自动回溯 7 天
INACTIVE_DAYS=14
# 全站每日成本上限（元，含模型和博查，北京时间零点重置），0 表示不限
DAILY_BUDGET_YUAN=10

# ---------- 预警邮件（不填则不发，用户在网站「设置」里填自己的邮箱） ----------
# QQ 邮箱：smtp.qq.com / 465，密码填「设置 → 账户 → 开启 SMTP 服务」生成的授权码，不是 QQ 密码
# 163 邮箱：smtp.163.com / 465；腾讯企业邮：smtp.exmail.qq.com / 465
# 腾讯云服务器封了 25 端口，用 465（SSL）或 587（STARTTLS）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 邮件里「打开网站」的链接
SITE_URL=https://investwise.example.com
